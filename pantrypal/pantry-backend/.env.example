PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/pantrypal
JWT_SECRET=pantry_pal_finalist_2026_secret

# SMS (optional - for purchase & login notifications)
# Option 1: Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Option 2: Fast2SMS (India - free credits at fast2sms.com)
FAST2SMS_API_KEY=

# Email (optional - for login & purchase notifications)
# Example for Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# WhatsApp Cloud API (alternative to SMS)
# Create a Meta App + WhatsApp Cloud API, then set:
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Optional: only needed if you want to send template messages (recommended for login)
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en_US
# Optional: Graph API version (defaults v20.0)
WHATSAPP_GRAPH_VERSION=v20.0
